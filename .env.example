# Copy to .env.local and fill in values for your own deployment.
# Required for Alembic: a PostgreSQL connection string.
DATABASE_URL=

# Required when loading retrieval configuration; use the model ID served by your API.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=2048
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=60

# Optional shared vision chat service for Caption, OCR and image classification.
# Leave both BASE_URL and MODEL empty to disable vision capabilities.
CAPTION_BASE_URL=
CAPTION_MODEL=
CAPTION_API_KEY=
CAPTION_TIMEOUT_SECONDS=120

# Optional structured-decision service behind POST {BASE_URL}/systemone, for
# example `vllm serve vllm-sr/d3-mini` on http://localhost:8004/v1.
# Leave both BASE_URL and MODEL empty to disable decision capabilities.
DECISION_BASE_URL=
DECISION_MODEL=
DECISION_API_KEY=
DECISION_TIMEOUT_SECONDS=60
# Request dialect: auto derives it from DECISION_MODEL, or pin d3 / clef / generic.
DECISION_MODEL_PROFILE=auto

# Storage initialization; blank profile name uses local-default or s3-default.
STORAGE_BACKEND=local
STORAGE_PROFILE_NAME=
LOCAL_STORAGE_ROOT=./data/assets
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_ADDRESSING_STYLE=path
S3_SIGNATURE_VERSION=s3v4
S3_CREDENTIAL_PROFILE=
# Original-file API currently uses proxy reads; reserved for future modes.
ASSET_READ_MODE=proxy

# Resource management input limits (bytes / characters per text field).
MAX_UPLOAD_BYTES=20971520
MAX_TEXT_CHARS=100000
